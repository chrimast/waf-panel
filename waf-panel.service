[Unit]
Description=1Panel WAF Management Panel
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/waf-panel
EnvironmentFile=/opt/waf-panel/.env
ExecStart=/opt/waf-panel/venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 10087
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
